# ---------- Locale ----------
PRIMARY_COUNTRY=IN
PRIMARY_CURRENCY=INR
SECOND_COUNTRY=US
SECOND_CURRENCY=USD
# Books / items above this value (in primary currency) go to human appraisal, never auto-priced
APPRAISAL_THRESHOLD=10000

# ---------- Live voice (Gemini Live API, https://aistudio.google.com/apikey) ----------
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live

# ---------- Vision + reasoning (https://openrouter.ai/keys) ----------
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=google/gemini-3.8-flash
OPENROUTER_TEXT_MODEL=google/gemini-3.5-flash-lite

# ---------- Price + catalogue sources ----------
# https://console.cloud.google.com/apis/library/books.googleapis.com
GOOGLE_BOOKS_API_KEY=
# https://developer.ebay.com/my/keys  (Production keyset, client-credentials grant)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Open Library and Frankfurter (FX) need no key

# ---------- Storage ----------
# Supabase: Project settings -> API. Service role key is server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=frames
# MongoDB Atlas (raw VLM outputs, transcripts, event log). Optional: falls back to local JSONL.
MONGODB_URI=
MONGODB_DB=spinesight

# ---------- Tracing (https://smith.langchain.com) ----------
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=spinesight

# ---------- Wiring ----------
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000
